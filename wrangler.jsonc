{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "aurielle",
	"compatibility_date": "2026-08-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// NEXT_PUBLIC_SITE_URL is set as a GitHub Actions build-time env var
	// (.github/workflows/deploy.yml) for generateStaticParams()/
	// metadataBase, but that alone never reaches the deployed Worker's
	// own runtime -- same root cause as the SMTP_* secrets needing a
	// `wrangler secret put` sync step. This one isn't sensitive (it's a
	// public URL, hence the NEXT_PUBLIC_ prefix), so a plain `vars`
	// entry here is the right place rather than a secret: it's real
	// config, committed to the repo, available the moment this file
	// deploys, no CI sync step needed. Used at request time by
	// src/lib/email/reply-template.ts to build the logo's absolute URL
	// and the footer's website link.
	"vars": {
		"NEXT_PUBLIC_SITE_URL": "https://auriellefragrancestudio.com"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// Cloudflare serves a matching static asset directly, bypassing the
		// Worker script (and therefore Next's middleware.ts) entirely, by
		// default. The root path "/" needs the middleware's host-based
		// rewrite (admin-aurielle.altasme.com's "/" -> "/admin") to run on
		// every request, so it's forced through the Worker; every other
		// path keeps the faster direct-asset-serving default.
		"run_worker_first": ["/"]
	},
	"services": [
		{
			// Self-reference service binding required by the OpenNext adapter.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aurielle"
		}
	]
	// No r2_buckets / images bindings yet: no next/image optimization
	// (images.unoptimized in next.config.ts), and the catalogue pages'
	// `export const revalidate` currently has no durable cache to write
	// to without one (see README "Deploying to Cloudflare") -- each
	// request just renders fresh instead of serving a cached copy, which
	// is correct but not free ISR. Add an r2_buckets binding per
	// https://opennext.js.org/cloudflare/caching if that becomes worth it.
}
